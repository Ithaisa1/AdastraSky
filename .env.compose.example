# Copia este fichero como .env en la raíz para docker compose. NUNCA lo subas a Git.

# PostgreSQL local (elige una contraseña larga)
POSTGRES_PASSWORD=cambia-esta-contraseña

# Seguridad (genera valores aleatorios: openssl rand -hex 32)
JWT_SECRET=
AI_SERVICE_API_KEY=
N8N_API_KEY=

# Proveedores de IA (al menos uno; sin ninguno el chat funciona en modo documentos)
GROQ_API_KEY=
OPENAI_API_KEY=
HF_TOKEN=

# APIs externas opcionales
OPENWEATHER_API_KEY=
NASA_API_KEY=

# Usuarios iniciales (solo se crean si la tabla de usuarios está vacía)
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=

# URLs públicas
FRONTEND_URL=http://localhost:8080
PUBLIC_API_URL=http://localhost:5000
CONTACT_EMAIL=
