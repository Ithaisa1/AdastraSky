# ============================================================
# ADASTRASKY AI SERVICE — VARIABLES DE ENTORNO
# ============================================================

# Puerto del servidor FastAPI
PORT=8001

# LLM Provider (Groq > OpenAI > Hugging Face > RAG-only fallback)
# Groq (recomendado): https://console.groq.com/keys
GROQ_API_KEY=gsk_tu_clave_groq_aqui
GROQ_MODEL=llama-3.3-70b-versatile
# OpenAI (alternativa)
OPENAI_API_KEY=sk-tu_clave_aqui
OPENAI_MODEL=gpt-4o-mini
# Hugging Face (alternativa): https://huggingface.co/settings/tokens
HF_TOKEN=hf_tu_token_aqui
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# Base de datos PostgreSQL (compartida con backend)
DATABASE_URL=postgresql://postgres:tu_password@localhost:5432/adastra_sky

# APIs externas
OPENWEATHER_API_KEY=tu_clave_openweather_aqui
NASA_API_KEY=tu_clave_nasa_api_aqui

# CORS
FRONTEND_URL=http://localhost:5173

# Clave compartida backend/n8n -> ai-service (cabecera X-API-Key). OBLIGATORIA en producción.
# Genera una con: openssl rand -hex 24  (la misma en el backend)
AI_SERVICE_API_KEY=

# Backend del que se leen las zonas para el planificador
BACKEND_URL=https://aadastra-sky-backend.onrender.com

# Memoria conversacional (límites del historial enviado al modelo)
HISTORY_MAX_TURNS=6
HISTORY_MAX_CHARS=6000

# Tiempos de espera (segundos)
LLM_TIMEOUT_SECONDS=30
CHAT_TIMEOUT_SECONDS=90
