# ============================================================
# ADASTRASKY - VARIABLES DE ENTORNO (BACKEND)
# ============================================================
# Copia este archivo como .env y rellena los valores reales

# Puerto del servidor
PORT=5000

# Entorno de ejecución
NODE_ENV=development

# ============================================================
# BASE DE DATOS - PostgreSQL
# ============================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=adastrasky
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
# O bien una cadena completa (Neon, Supabase, Render…). Tiene prioridad sobre DB_*.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require
# SSL: true por defecto con DATABASE_URL; pon false para PostgreSQL local/Docker
# DB_SSL=true
# Pool pequeño y sin conexiones mínimas (permite que Neon suspenda la BD inactiva)
# DB_POOL_MAX=5
# DB_POOL_MIN=0

# ============================================================
# AUTENTICACIÓN JWT
# ============================================================
JWT_SECRET=tu_jwt_secret_super_secreto_aqui
JWT_EXPIRES_IN=7d

# ============================================================
# MICROSERVICIO DE IA (Python FastAPI)
# ============================================================
AI_SERVICE_URL=http://localhost:8001
# Debe coincidir con AI_SERVICE_API_KEY del ai-service
AI_SERVICE_API_KEY=
# Turnos de conversación que se envían como memoria al agente
CHAT_HISTORY_TURNS=6
# Clave para n8n (cabecera x-api-key en POST /api/sky/score)
N8N_API_KEY=
# Usuarios iniciales y zonas (solo si las tablas están vacías)
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
AUTO_SEED_ZONES=true

# ============================================================
# APIs EXTERNAS
# ============================================================
OPENWEATHER_API_KEY=tu_clave_openweather_aqui
NASA_API_KEY=tu_clave_nasa_api_aqui

# ============================================================
# FRONTEND
# ============================================================
FRONTEND_URL=http://localhost:5173

# ============================================================
# RATE LIMITING
# ============================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100